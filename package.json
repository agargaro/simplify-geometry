{
  "name": "@three.ez/simplify-geometry",
  "version": "1.0.0",
  "description": "Simplify three.js BufferGeometry and generate LOD levels with meshoptimizer.",
  "author": "Andrea Gargaro <devgargaro@gmail.com>",
  "license": "MIT",
  "type": "module",
  "module": "./build/index.js",
  "types": "./build/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/types/index.d.ts",
      "import": "./build/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "build",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "three",
    "three.js",
    "threejs",
    "simplify",
    "simplification",
    "decimation",
    "meshoptimizer",
    "LOD",
    "level-of-detail",
    "performance"
  ],
  "homepage": "https://github.com/agargaro/simplify-geometry#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agargaro/simplify-geometry.git"
  },
  "bugs": {
    "url": "https://github.com/agargaro/simplify-geometry/issues"
  },
  "scripts": {
    "start": "vite",
    "build": "vite build && tsc -p tsconfig.build.json",
    "build:site": "vite build -c vite.site.config.ts",
    "preview:site": "vite preview -c vite.site.config.ts",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "lint:style": "eslint -c eslint.style.config.js src",
    "test:package": "node scripts/check-package.ts",
    "check": "npm run build && npm run lint && npm run typecheck && npm run test:package",
    "release": "npm run check && npm publish"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@three.ez/instanced-mesh": "1.0.0-beta.1",
    "@three.ez/main": "0.5.12",
    "@tweakpane/core": "2.0.5",
    "@types/node": "26.6.6",
    "@types/three": "0.186.0",
    "eslint": "10.14.0",
    "three": "0.186.1",
    "tweakpane": "4.0.5",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.7"
  },
  "peerDependencies": {
    "three": ">=0.159.0"
  },
  "dependencies": {
    "meshoptimizer": "^1.3.0"
  }
}
